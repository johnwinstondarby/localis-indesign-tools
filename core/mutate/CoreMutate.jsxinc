        return work;
    }

    function validateComparator(targets, comparator) {
        var first, second;
        var i, j, a, b, selfValue, forward1, forward2, reverse1, reverse2;
        if (typeof comparator !== "function") {
            return {ok: false, reason: "compareLocators() is required."};
        }
        try {
            for (i = 0; i < targets.length; i++) {
                a = targets[i];
                selfValue = signNumber(comparator(a, a));
                if (selfValue !== 0) {
                    return {ok: false, reason: "Comparator must return 0 for a locator compared with itself."};
                }
            }

            /*
            Determinism is checked pairwise before sorting. Repeated sorting alone
            can miss a stateful comparator whose call pattern happens to repeat.
            */
            for (i = 0; i < targets.length; i++) {
                for (j = i + 1; j < targets.length; j++) {
                    a = targets[i];
                    b = targets[j];
                    forward1 = signNumber(comparator(a, b));
                    forward2 = signNumber(comparator(a, b));
                    reverse1 = signNumber(comparator(b, a));
                    reverse2 = signNumber(comparator(b, a));
                    if (forward1 !== forward2 || reverse1 !== reverse2) {
                        return {ok: false, reason: "Comparator returned inconsistent results for the same locator pair."};
                    }
                    if (forward1 !== -reverse1) {
                        return {ok: false, reason: "Comparator failed antisymmetry validation."};
                    }
                }
            }

            first = sortWithGuard(targets, comparator);
            second = sortWithGuard(targets, comparator);
            if (!compareSerializedArrays(first, second)) {
                return {ok: false, reason: "Comparator produced inconsistent ordering across repeated sorts."};
            }
            return {ok: true, ordered: first};
        } catch (eComparator) {
            return {ok: false, reason: "Comparator error: " + eComparator.message};
        }
    }

    function normalizePrecheck(value) {
        if (value === true) { return {eligible: true, reason: ""}; }
        if (value === false || value === null || value === undefined) {
            return {eligible: false, reason: ""};
        }
        if (typeof value === "object" && value.eligible !== undefined) {
            return {eligible: value.eligible === true, reason: value.reason ? String(value.reason) : ""};
        }
        return {eligible: value === true, reason: ""};
    }

    function normalizeVerify(value) {
        if (value === true) { return {ok: true, reason: ""}; }
        if (value === false || value === null || value === undefined) {
            return {ok: false, reason: ""};
        }
        if (typeof value === "object" && value.ok !== undefined) {
            return {ok: value.ok === true, reason: value.reason ? String(value.reason) : ""};
        }
        return {ok: value === true, reason: ""};
    }

    function makeItem(locator, ordinal, mode, host) {
        return {
            processingOrdinal: ordinal,
            targetLocator: locator,
            locatorText: safeLocatorString(locator),
            executionMode: mode,
            resolveResult: null,
            precheckResult: null,
            snapshotCaptured: false,
            rollbackReady: null,
            rollbackReadinessReason: "",
            digestCoverage: null,
            preMutationDigestCaptured: false,
            mutationAttempted: false,
            mutationResult: null,
            verificationResult: null,
            rollbackAttempted: false,
            rollbackResult: null,
            postRollbackDigestResult: null,
            reasonCode: "",
            failureStage: "",
            finalState: null,
            planState: null,
            errorText: "",
