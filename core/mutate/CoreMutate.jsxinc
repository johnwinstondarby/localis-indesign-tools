                item.errorText = precheck.reason;
                if (mode === MODE_DRY_RUN) { item.planState = PLAN_SKIPPED; }
                else { item.finalState = STATE_SKIPPED; }
                item.completedAt = nowISO(host);
                batch.items.push(item);
