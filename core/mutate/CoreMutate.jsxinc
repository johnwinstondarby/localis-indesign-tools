var CoreMutate = (function () {
    var VERSION = "1.0.0-dev4";
    var MODE_LIVE = "LIVE";
    var MODE_DRY_RUN = "DRY_RUN";

    var STATE_COMMITTED = "COMMITTED";
    var STATE_SKIPPED = "SKIPPED";
    var STATE_REFUSED = "REFUSED";
    var STATE_ROLLED_BACK = "ROLLED_BACK";
    var STATE_HARD_STOP = "HARD_STOP";
    var STATE_NOT_ATTEMPTED = "NOT_ATTEMPTED";

    var BATCH_COMPLETE = "COMPLETE";
    var BATCH_HALTED = "HALTED";

    var PLAN_READY = "PLAN_READY";
    var PLAN_SKIPPED = "PLAN_SKIPPED";
    var PLAN_REFUSED = "PLAN_REFUSED";
    var PLAN_HALTED = "PLAN_HALTED";

