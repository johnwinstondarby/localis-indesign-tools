        for (i = 0; i < items.length; i++) {
            item = items[i];
            if (item.finalState === STATE_COMMITTED) { counts.committed++; }
            else if (item.finalState === STATE_SKIPPED) { counts.skipped++; }
            else if (item.finalState === STATE_REFUSED) { counts.refused++; }
            else if (item.finalState === STATE_ROLLED_BACK) { counts.rolledBack++; }
            else if (item.finalState === STATE_HARD_STOP) { counts.hardStops++; }
            else if (item.finalState === STATE_NOT_ATTEMPTED) { counts.notAttempted++; }

            if (item.planState === PLAN_READY) { counts.planReady++; }
            else if (item.planState === PLAN_SKIPPED) { counts.planSkipped++; }
            else if (item.planState === PLAN_REFUSED) { counts.planRefused++; }
