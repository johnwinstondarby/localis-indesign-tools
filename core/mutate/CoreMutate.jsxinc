    function writeBatchOrFlag(batch, writer) {
        if (!writer || !batch.journalDurable) { return false; }
        try {
            journalRecord(writer, "BATCH", batchSummaryForJournal(batch));
            return true;
        } catch (eWrite) {
            batch.journalDurable = false;
            batch.journalError = eWrite.message;
            return false;
        }
    }

    function batchSummaryForJournal(batch) {
        return {
            coreVersion: batch.coreVersion,
            batchId: batch.batchId,
            batchLabel: batch.batchLabel,
            executionMode: batch.executionMode,
            undoLabel: batch.undoLabel,
            adapterId: batch.adapterId,
            adapterVersion: batch.adapterVersion,
            lastConformanceVersion: batch.lastConformanceVersion,
            lastConformanceDate: batch.lastConformanceDate,
            targetsRequested: batch.targetsRequested,
            startedAt: batch.startedAt,
            completedAt: batch.completedAt,
            batchState: batch.batchState,
            planningState: batch.planningState,
            batchReason: batch.batchReason,
            journalDurable: batch.journalDurable,
