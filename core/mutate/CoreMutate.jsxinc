    function safeLocatorString(locator) {
        try { return locatorString(locator); } catch (e) { return "<UNSERIALIZABLE_LOCATOR>"; }
    }

    function markNotAttempted(items, orderedTargets, startIndex, mode, host) {
        var i, item;
