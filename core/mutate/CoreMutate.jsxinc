            coreVersion: VERSION,
            batchId: String((new Date()).getTime()) + "-" + String(Math.floor(Math.random() * 1000000)),
            batchLabel: String(label || "core/mutate transaction"),
            executionMode: mode,
            undoLabel: mode === MODE_LIVE ? String(label || "core/mutate transaction") : "",
            adapterId: adapter && adapter.adapterId ? String(adapter.adapterId) : "",
            adapterVersion: adapter && adapter.adapterVersion ? String(adapter.adapterVersion) : "",
            lastConformanceVersion: adapter && adapter.lastConformanceVersion ? String(adapter.lastConformanceVersion) : "",
            lastConformanceDate: adapter && adapter.lastConformanceDate ? String(adapter.lastConformanceDate) : "",
