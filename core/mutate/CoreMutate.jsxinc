            mutateError = null;
            try {
                adapter.mutate(target, snapshot, locator);
                item.mutationResult = "RETURNED";
            } catch (eMutate) {
                mutateError = eMutate;
                item.mutationResult = "ERROR";
                item.reasonCode = "MUTATE_ERROR";
                item.failureStage = "MUTATE";
                appendErrorText(item, "MUTATE", eMutate.message);
            }

            verifyResult = null;
            if (mutateError === null) {
                try {
                    verifyTarget = adapter.resolve(locator);
                    if (verifyTarget === null || verifyTarget === undefined) {
                        throw new Error("Target could not be re-acquired for verification.");
                    }
                    item.resolveResult = "REACQUIRED_FOR_VERIFY";
                } catch (eVerifyResolve) {
                    item.reasonCode = "RESOLVE_FAILED";
                    item.failureStage = "VERIFY_RESOLVE";
                    appendErrorText(item, "VERIFY_RESOLVE", eVerifyResolve.message);
                    item.finalState = STATE_HARD_STOP;
                    item.completedAt = nowISO(host);
                    batch.items.push(item);
                    writeItemOrFlag(batch, writer, item);
                    batch.batchState = BATCH_HALTED;
                    batch.batchReason = "HARD_STOP";
                    markNotAttempted(batch.items, orderedTargets, i + 1, mode, host);
                    return;
                }

                try {
                    verifyResult = normalizeVerify(adapter.verify(verifyTarget, snapshot, preDigestRaw, locator));
                    item.verificationResult = verifyResult.ok ? "PASS" : "FAIL";
                    if (!verifyResult.ok) {
                        item.reasonCode = "VERIFY_FAILED";
                        item.failureStage = "VERIFY";
                        appendErrorText(item, "VERIFY", verifyResult.reason);
                    }
                } catch (eVerify) {
                    verifyResult = {ok: false, reason: eVerify.message};
                    item.verificationResult = "ERROR";
                    item.reasonCode = "VERIFY_ERROR";
                    item.failureStage = "VERIFY";
                    appendErrorText(item, "VERIFY", eVerify.message);
                }
            }

            if (mutateError === null && verifyResult && verifyResult.ok) {
                item.finalState = STATE_COMMITTED;
                item.completedAt = nowISO(host);
                batch.items.push(item);
                if (!writeItemOrFlag(batch, writer, item)) {
                    journalFailedAfterProof = true;
                }
                if (journalFailedAfterProof) {
                    batch.batchState = BATCH_HALTED;
                    batch.batchReason = "JOURNAL_FAILURE";
                    markNotAttempted(batch.items, orderedTargets, i + 1, mode, host);
                    return;
                }
                continue;
            }

            item.rollbackAttempted = true;
            try {
                rollbackTarget = adapter.resolve(locator);
                if (rollbackTarget === null || rollbackTarget === undefined) {
                    throw new Error("Target could not be re-acquired for rollback.");
                }
                adapter.rollback(rollbackTarget, snapshot, locator);
                item.rollbackResult = "RETURNED";
            } catch (eRollback) {
                item.rollbackResult = "ERROR";
                item.reasonCode = "ROLLBACK_ERROR";
                item.failureStage = "ROLLBACK";
                appendErrorText(item, "ROLLBACK", eRollback.message);
                item.finalState = STATE_HARD_STOP;
                item.completedAt = nowISO(host);
                batch.items.push(item);
                writeItemOrFlag(batch, writer, item);
                batch.batchState = BATCH_HALTED;
                batch.batchReason = "HARD_STOP";
                markNotAttempted(batch.items, orderedTargets, i + 1, mode, host);
                return;
            }

            try {
                postTarget = adapter.resolve(locator);
                if (postTarget === null || postTarget === undefined) {
                    throw new Error("Target could not be re-acquired after rollback.");
                }
                postDigestRaw = adapter.rollbackDigest(postTarget, locator);
                postDigest = digestSignature(coverage, postDigestRaw);
                if (!postDigest.ok) {
                    item.postRollbackDigestResult = "ERROR";
                    item.reasonCode = postDigest.serializationError ? "ROLLBACK_DIGEST_ERROR" : "ROLLBACK_DIGEST_KEY_MISMATCH";
                    item.failureStage = "ROLLBACK_DIGEST";
                    appendErrorText(item, "ROLLBACK_DIGEST", postDigest.reason);
                    item.finalState = STATE_HARD_STOP;
                } else if (postDigest.signature !== preDigest.signature) {
                    item.postRollbackDigestResult = "MISMATCH";
                    item.reasonCode = "ROLLBACK_DIGEST_MISMATCH";
                    item.failureStage = "ROLLBACK_DIGEST";
                    item.finalState = STATE_HARD_STOP;
                } else {
                    item.postRollbackDigestResult = "MATCH";
                    item.finalState = STATE_ROLLED_BACK;
                }
            } catch (ePostDigest) {
                item.postRollbackDigestResult = "ERROR";
                item.reasonCode = "ROLLBACK_DIGEST_ERROR";
                item.failureStage = "ROLLBACK_DIGEST";
                appendErrorText(item, "ROLLBACK_DIGEST", ePostDigest.message);
                item.finalState = STATE_HARD_STOP;
            }

            item.completedAt = nowISO(host);
            batch.items.push(item);
            if (!writeItemOrFlag(batch, writer, item)) {
                journalFailedAfterProof = true;
            }

            if (item.finalState === STATE_HARD_STOP) {
                batch.batchState = BATCH_HALTED;
                batch.batchReason = "HARD_STOP";
                markNotAttempted(batch.items, orderedTargets, i + 1, mode, host);
                return;
            }

            if (journalFailedAfterProof) {
                batch.batchState = BATCH_HALTED;
                batch.batchReason = "JOURNAL_FAILURE";
                markNotAttempted(batch.items, orderedTargets, i + 1, mode, host);
                return;
            }
        }

        if (mode === MODE_DRY_RUN) {
            batch.planningState = PLAN_READY;
        } else {
            batch.batchState = BATCH_COMPLETE;
        }
    }

    function transaction(label, targets, adapter, options) {
        var opts = options || {};
        var mode = opts.mode === MODE_DRY_RUN ? MODE_DRY_RUN : MODE_LIVE;
        var host = opts.host || createInDesignHost();
        var inputTargets = copyArray(targets || []);
        var batch = makeBatch(label, inputTargets, adapter || {}, mode, host);
        var writer = null;
        var comparatorCheck, orderedTargets;
        var runError = null;

        if (!adapter || typeof adapter.resolve !== "function" ||
            typeof adapter.precheck !== "function" ||
            typeof adapter.snapshot !== "function" ||
            typeof adapter.digestCoverage !== "function" ||
            typeof adapter.rollbackDigest !== "function" ||
            typeof adapter.mutate !== "function" ||
            typeof adapter.verify !== "function" ||
            typeof adapter.rollback !== "function") {
            return preflightHalt(batch, inputTargets, mode, host, "ADAPTER_CONTRACT_MISMATCH");
        }

        try {
            writer = openWriter(opts, batch);
            journalRecord(writer, "HEADER", {
                format: "CORE_MUTATE_JOURNAL",
                formatVersion: 1,
                coreVersion: VERSION,
                batchId: batch.batchId,
                batchLabel: batch.batchLabel,
                executionMode: batch.executionMode,
                adapterId: batch.adapterId,
                adapterVersion: batch.adapterVersion,
                lastConformanceVersion: batch.lastConformanceVersion,
                lastConformanceDate: batch.lastConformanceDate,
                startedAt: batch.startedAt
            });
        } catch (eJournalOpen) {
            batch.journalDurable = false;
            batch.journalError = eJournalOpen.message;
            preflightHalt(batch, inputTargets, mode, host, "JOURNAL_UNAVAILABLE");
            batch.completedAt = nowISO(host);
            return batch;
        }

        if (mode === MODE_LIVE &&
            (String(adapter.adapterVersion || "").length === 0 ||
             String(adapter.lastConformanceVersion || "").length === 0 ||
             String(adapter.lastConformanceDate || "").length === 0 ||
             String(adapter.adapterVersion || "") !== String(adapter.lastConformanceVersion || ""))) {
            preflightHalt(batch, inputTargets, mode, host, "ADAPTER_CONFORMANCE_STALE");
            return finalizeBatch(batch, writer, host);
        }

        comparatorCheck = validateComparator(inputTargets, adapter.compareLocators);
        if (!comparatorCheck.ok) {
            preflightHalt(batch, inputTargets, mode, host, "ADAPTER_CONTRACT_MISMATCH");
            batch.preflightError = comparatorCheck.reason;
            return finalizeBatch(batch, writer, host);
        }
        orderedTargets = comparatorCheck.ordered;

        if (mode === MODE_DRY_RUN) {
            processBatch(batch, orderedTargets, adapter, opts, host, writer);
            if (batch.planningState === null) { batch.planningState = PLAN_READY; }
            return finalizeBatch(batch, writer, host);
        }

        try {
            host.runUndoGroup(batch.undoLabel, function () {
                processBatch(batch, orderedTargets, adapter, opts, host, writer);
                if (batch.batchState === null) { batch.batchState = BATCH_COMPLETE; }
            });
        } catch (eHost) {
            runError = eHost;
            batch.batchState = BATCH_HALTED;
            batch.batchReason = "HOST_ERROR";
            batch.undoIntegrityUnknown = true;
            batch.hostError = eHost.message;
        }

        return finalizeBatch(batch, writer, host);
    }

    function createInDesignHost() {
        return {
            now: function () {
                try { return (new Date()).toISOString(); } catch (e) { return String(new Date()); }
            },
            runUndoGroup: function (label, fn) {
                var result;
                app.doScript(function () {
                    result = fn();
                }, ScriptLanguage.JAVASCRIPT, undefined, UndoModes.ENTIRE_SCRIPT, label);
                return result;
            }
        };
    }

    function createFileJournalWriter(path) {
        var journalFile;
        var firstWrite = true;

        if (typeof File === "undefined") {
            throw new Error("ExtendScript File API is unavailable.");
        }

        journalFile = new File(path);

        if (!journalFile.parent.exists && !journalFile.parent.create()) {
            throw new Error("Could not create journal directory: " + journalFile.parent.fsName);
        }

        return {
            write: function (kind, record) {
                var file = new File(journalFile.fsName);
                var writeOk = false;
                var closeOk = true;
                var failure = null;
                var errorText = "";

                file.encoding = "UTF-8";
                file.lineFeed = "Windows";

                if (!file.open(firstWrite ? "w" : "a")) {
                    throw new Error("Could not open journal file: " + file.fsName);
                }

                firstWrite = false;

                try {
                    writeOk = file.writeln(
                        String(kind) + "\t" + canonicalSerialize(record)
                    );

                    if (writeOk !== true) {
                        try { errorText = String(file.error || ""); }
                        catch (eErrorText) { errorText = ""; }

                        throw new Error(
                            "Could not write journal record: " +
                            file.fsName +
                            (errorText.length > 0 ? " | " + errorText : "")
                        );
                    }

                    if (typeof file.flush === "function") {
                        file.flush();
                    }

                    try { errorText = String(file.error || ""); }
                    catch (ePostWriteError) { errorText = ""; }

                    if (errorText.length > 0) {
                        throw new Error(
                            "Journal file error after write: " +
                            file.fsName +
                            " | " +
                            errorText
                        );
                    }
                } catch (eWrite) {
                    failure = eWrite;
                }

                try {
                    if (file.opened) {
                        closeOk = file.close();

                        if (closeOk === false && !failure) {
                            failure = new Error(
                                "Could not close journal file: " +
                                file.fsName
                            );
                        }
                    }
                } catch (eClose) {
                    if (!failure) {
                        failure = eClose;
                    }
                }

                if (failure) {
                    throw failure;
                }
            },

            close: function () {
                /* Each logical record is flushed and closed by write(). */
            },

            path: journalFile.fsName
        };
    }

    return {
        VERSION: VERSION,
        MODE_LIVE: MODE_LIVE,
        MODE_DRY_RUN: MODE_DRY_RUN,
        NOT_APPLICABLE: NOT_APPLICABLE,
        transaction: transaction,
        createInDesignHost: createInDesignHost,
        createFileJournalWriter: createFileJournalWriter,
        canonicalSerialize: canonicalSerialize,
        validateDigestKeys: validateDigestKeys,
        states: {
            COMMITTED: STATE_COMMITTED,
            SKIPPED: STATE_SKIPPED,
            REFUSED: STATE_REFUSED,
            ROLLED_BACK: STATE_ROLLED_BACK,
            HARD_STOP: STATE_HARD_STOP,
            NOT_ATTEMPTED: STATE_NOT_ATTEMPTED
        },
        batchStates: {
            COMPLETE: BATCH_COMPLETE,
            HALTED: BATCH_HALTED
        },
        planStates: {
            READY: PLAN_READY,
            SKIPPED: PLAN_SKIPPED,
            REFUSED: PLAN_REFUSED,
            HALTED: PLAN_HALTED
        }
    };
}());

if (typeof module !== "undefined" && module.exports) {
    module.exports = CoreMutate;
}
